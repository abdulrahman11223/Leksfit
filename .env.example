# Postgres connection string, e.g. from Neon/Supabase/Railway
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Long random string used to sign session cookies — any gibberish works
SESSION_SECRET=

# Cloudinary — from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port the server runs on locally (Render sets this automatically)
PORT=3000
